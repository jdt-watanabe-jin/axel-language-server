{
	"name": "axel-language-server",
	"description": "AXEL language server",
	"version": "1.0.0",
	"author": "JinWatanabe",
	"main": "out/server.js",
	"files": [
		"out/",
		"src/",
		"package.json"
	],
	"license": "MIT",
	"engines": {
		"node": "*"
	},
	"dependencies": {
		"vscode-languageserver": "^9.0.1",
		"vscode-languageserver-textdocument": "^1.0.11",
		"tree-sitter": "^0.22.4",
		"tree-sitter-axel": "git+https://github.com/jdt-watanabe-jin/tree-sitter-axel.git#v0.1.0",
		"tree-sitter-cli": "^0.24.5"
	},
	"scripts": {
		"build": "tsc",
		"test": "node scripts/run-tests.mjs all",
		"test:watch": "node --watch-path=src scripts/run-tests.mjs fast",
		"prepare": "npm run build",
		"lint": "eslint",
		"test:unit": "node scripts/run-tests.mjs unit",
		"test:integration": "node scripts/run-tests.mjs integration",
		"test:e2e": "node scripts/run-tests.mjs e2e",
		"test:performance": "node scripts/run-tests.mjs performance",
		"test:external": "node scripts/run-tests.mjs external",
		"test:fast": "node scripts/run-tests.mjs fast",
		"test:complete": "node scripts/run-tests.mjs complete",
		"test:ci": "npm run lint && npm test"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/mocha": "^10.0.6",
		"@types/node": "^22",
		"eslint": "^9.13.0",
		"mocha": "^10.3.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0"
	}
}
